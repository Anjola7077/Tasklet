<?xml version="1.0" encoding="utf-8" ?><ContentPage
xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
x:Class="Tasklet.MainPage"
BackgroundColor="#090B0A"
Shell.NavBarIsVisible="False">

<ContentPage.Resources>

    <Color x:Key="Accent">#5EEAD4</Color>
    <Color x:Key="AccentLight">#99F6E4</Color>
    <Color x:Key="Surface">#141816</Color>
    <Color x:Key="SurfaceLight">#1C211F</Color>
    <Color x:Key="Border">#303833</Color>
    <Color x:Key="TextPrimary">#F4F4F5</Color>
    <Color x:Key="TextSecondary">#A1A1AA</Color>
    <Color x:Key="TextMuted">#71717A</Color>
    <Color x:Key="Success">#4ADE80</Color>
    <Color x:Key="Warning">#FBBF24</Color>
    <Color x:Key="Danger">#FB7185</Color>

    <Style x:Key="FilterButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#181C19" />
        <Setter Property="TextColor" Value="#A1A1AA" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="15,9" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="BorderColor" Value="#303833" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="HeightRequest" Value="39" />
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#5EEAD4" />
        <Setter Property="TextColor" Value="#09201C" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="17,11" />
    </Style>

</ContentPage.Resources>

<Grid RowDefinitions="*,Auto">

    <!-- Main scrolling dashboard -->
    <ScrollView
        x:Name="MainScrollView"
        Grid.Row="0"
        VerticalScrollBarVisibility="Never">

        <VerticalStackLayout
            Padding="21,22,21,30"
            Spacing="25">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto"
                  VerticalOptions="Center">

                <VerticalStackLayout Spacing="5">

                    <Label
                        x:Name="DateLabel"
                        Text="YOUR DAY, YOUR PACE"
                        FontSize="10"
                        FontAttributes="Bold"
                        CharacterSpacing="2"
                        TextColor="#5EEAD4" />

                    <Label
                        Text="Tasklet"
                        FontSize="34"
                        FontAttributes="Bold"
                        TextColor="#F4F4F5" />

                    <Label
                        Text="Make room for what matters."
                        FontSize="13"
                        TextColor="#A1A1AA" />

                </VerticalStackLayout>

                <Border
                    Grid.Column="1"
                    WidthRequest="48"
                    HeightRequest="48"
                    BackgroundColor="#172B28"
                    Stroke="#31534C"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    VerticalOptions="Center">

                    <Label
                        Text="T"
                        FontSize="23"
                        FontAttributes="Bold"
                        TextColor="#99F6E4"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />

                </Border>
            </Grid>

            <!-- Main tasks area -->
            <VerticalStackLayout
                x:Name="TaskSection"
                Spacing="23">

                <!-- Overview card -->
                <Border
                    Padding="18"
                    BackgroundColor="#141816"
                    Stroke="#293D37"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 23">

                    <VerticalStackLayout Spacing="17">

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout Spacing="4">
                                <Label
                                    Text="DAILY OVERVIEW"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    CharacterSpacing="1.5"
                                    TextColor="#A1A1AA" />

                                <Label
                                    Text="Your progress"
                                    FontSize="21"
                                    FontAttributes="Bold"
                                    TextColor="#F4F4F5" />
                            </VerticalStackLayout>

                            <Border
                                Grid.Column="1"
                                Padding="10,7"
                                BackgroundColor="#172B28"
                                Stroke="#31534C"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                VerticalOptions="Center">

                                <Label
                                    x:Name="ProgressLabel"
                                    Text="0%"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    TextColor="#99F6E4" />
                            </Border>

                        </Grid>

                        <ProgressBar
                            x:Name="ProgressBarView"
                            Progress="0"
                            ProgressColor="#5EEAD4"
                            BackgroundColor="#29352F"
                            HeightRequest="7" />

                        <Grid ColumnDefinitions="*,*,*"
                              ColumnSpacing="8">

                            <VerticalStackLayout Spacing="5">
                                <Label
                                    Text="TOTAL"
                                    FontSize="10"
                                    CharacterSpacing="1"
                                    TextColor="#A1A1AA" />

                                <Label
                                    x:Name="TotalLabel"
                                    Text="0"
                                    FontSize="24"
                                    FontAttributes="Bold"
                                    TextColor="#F4F4F5" />
                            </VerticalStackLayout>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="5">

                                <Label
                                    Text="DONE"
                                    FontSize="10"
                                    CharacterSpacing="1"
                                    TextColor="#A1A1AA" />

                                <Label
                                    x:Name="CompletedLabel"
                                    Text="0"
                                    FontSize="24"
                                    FontAttributes="Bold"
                                    TextColor="#4ADE80" />
                            </VerticalStackLayout>

                            <VerticalStackLayout
                                Grid.Column="2"
                                Spacing="5">

                                <Label
                                    Text="LEFT"
                                    FontSize="10"
                                    CharacterSpacing="1"
                                    TextColor="#A1A1AA" />

                                <Label
                                    x:Name="RemainingLabel"
                                    Text="0"
                                    FontSize="24"
                                    FontAttributes="Bold"
                                    TextColor="#99F6E4" />
                            </VerticalStackLayout>

                        </Grid>

                        <Label
                            x:Name="ProgressDescription"
                            Text="Add a task to get started."
                            FontSize="12"
                            TextColor="#A1A1AA" />

                    </VerticalStackLayout>
                </Border>

                <!-- Search and add -->
                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="9">

                        <Border
                            Padding="13,0"
                            BackgroundColor="#141816"
                            Stroke="#303833"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14"
                            HeightRequest="48">

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="10">

                                <Label
                                    Text="⌕"
                                    FontSize="25"
                                    TextColor="#A1A1AA"
                                    VerticalOptions="Center" />

                                <Entry
                                    x:Name="SearchEntry"
                                    Grid.Column="1"
                                    Placeholder="Find a task..."
                                    PlaceholderColor="#71717A"
                                    TextColor="#F4F4F5"
                                    BackgroundColor="Transparent"
                                    FontSize="14"
                                    ClearButtonVisibility="WhileEditing"
                                    VerticalOptions="Center"
                                    TextChanged="OnSearchChanged" />

                            </Grid>
                        </Border>

                        <Button
                            Grid.Column="1"
                            Text="+ New"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HeightRequest="48"
                            Clicked="OnAddTaskClicked" />

                    </Grid>

                    <!-- Filters -->
                    <ScrollView
                        Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never">

                        <HorizontalStackLayout Spacing="8">

                            <Button
                                x:Name="AllFilterButton"
                                Text="All tasks"
                                Style="{StaticResource FilterButtonStyle}"
                                Clicked="OnAllFilterClicked" />

                            <Button
                                x:Name="TodayFilterButton"
                                Text="Today"
                                Style="{StaticResource FilterButtonStyle}"
                                Clicked="OnTodayFilterClicked" />

                            <Button
                                x:Name="UpcomingFilterButton"
                                Text="Upcoming"
                                Style="{StaticResource FilterButtonStyle}"
                                Clicked="OnUpcomingFilterClicked" />

                            <Button
                                x:Name="DoneFilterButton"
                                Text="Completed"
                                Style="{StaticResource FilterButtonStyle}"
                                Clicked="OnDoneFilterClicked" />

                        </HorizontalStackLayout>
                    </ScrollView>

                </VerticalStackLayout>

                <!-- Task list heading -->
                <Grid ColumnDefinitions="*,Auto"
                      VerticalOptions="Center">

                    <VerticalStackLayout Spacing="5">

                        <Label
                            x:Name="TaskHeadingLabel"
                            Text="Your tasks"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="#F4F4F5" />

                        <Label
                            x:Name="TaskSubheadingLabel"
                            Text="Small steps count."
                            FontSize="12"
                            TextColor="#A1A1AA" />

                    </VerticalStackLayout>

                    <Border
                        Grid.Column="1"
                        Padding="10,7"
                        BackgroundColor="#1C211F"
                        Stroke="#303833"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 11"
                        VerticalOptions="Center">

                        <Label
                            x:Name="TaskCountLabel"
                            Text="0 tasks"
                            FontSize="12"
                            TextColor="#D4D4D8" />

                    </Border>
                </Grid>

                <!-- Empty state -->
                <Border
                    x:Name="EmptyState"
                    Padding="22,28"
                    BackgroundColor="#141816"
                    Stroke="#303833"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 21"
                    IsVisible="False">

                    <VerticalStackLayout
                        Spacing="11"
                        HorizontalOptions="Center">

                        <Border
                            WidthRequest="56"
                            HeightRequest="56"
                            BackgroundColor="#172B28"
                            Stroke="#31534C"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18">

                            <Label
                                Text="＋"
                                FontSize="28"
                                TextColor="#5EEAD4"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                        </Border>

                        <Label
                            x:Name="EmptyTitleLabel"
                            Text="A fresh start"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#F4F4F5"
                            HorizontalTextAlignment="Center" />

                        <Label
                            x:Name="EmptyDescriptionLabel"
                            Text="Add your first task and build some momentum."
                            FontSize="13"
                            TextColor="#A1A1AA"
                            HorizontalTextAlignment="Center"
                            HorizontalOptions="Center"
                            MaximumWidthRequest="270" />

                        <Button
                            Text="Create a task"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Clicked="OnAddTaskClicked"
                            Margin="0,7,0,0" />

                    </VerticalStackLayout>
                </Border>

                <!-- Dynamically generated task cards -->
                <VerticalStackLayout
                    x:Name="TaskList"
                    Spacing="12" />

            </VerticalStackLayout>

            <!-- Progress dashboard -->
            <VerticalStackLayout
                x:Name="ProgressSection"
                IsVisible="False"
                Spacing="19">

                <VerticalStackLayout Spacing="6">

                    <Label
                        Text="YOUR MOMENTUM"
                        FontSize="10"
                        FontAttributes="Bold"
                        CharacterSpacing="2"
                        TextColor="#5EEAD4" />

                    <Label
                        Text="Progress"
                        FontSize="30"
                        FontAttributes="Bold"
                        TextColor="#F4F4F5" />

                    <Label
                        Text="A clearer view of how far you've come."
                        FontSize="13"
                        TextColor="#A1A1AA" />

                </VerticalStackLayout>

                <Border
                    Padding="19"
                    BackgroundColor="#141816"
                    Stroke="#293D37"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 23">

                    <VerticalStackLayout Spacing="15">

                        <Label
                            Text="ALL-TIME COMPLETION"
                            FontSize="10"
                            FontAttributes="Bold"
                            CharacterSpacing="1.5"
                            TextColor="#A1A1AA" />

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Tasks completed"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="#F4F4F5"
                                VerticalOptions="Center" />

                            <Label
                                x:Name="OverviewCompletedLabel"
                                Grid.Column="1"
                                Text="0"
                                FontSize="30"
                                FontAttributes="Bold"
                                TextColor="#4ADE80" />

                        </Grid>

                        <ProgressBar
                            x:Name="OverviewProgressBar"
                            Progress="0"
                            ProgressColor="#4ADE80"
                            BackgroundColor="#29352F"
                            HeightRequest="8" />

                        <Label
                            x:Name="OverviewProgressDescription"
                            Text="Every completed task is progress."
                            FontSize="12"
                            TextColor="#A1A1AA" />

                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="12">

                    <Border
                        Padding="16"
                        BackgroundColor="#141816"
                        Stroke="#303833"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 19">

                        <VerticalStackLayout Spacing="9">

                            <Label
                                Text="TOTAL TASKS"
                                FontSize="10"
                                CharacterSpacing="1"
                                TextColor="#A1A1AA" />

                            <Label
                                x:Name="OverviewTotalLabel"
                                Text="0"
                                FontSize="30"
                                FontAttributes="Bold"
                                TextColor="#F4F4F5" />

                            <Label
                                Text="Created"
                                FontSize="12"
                                TextColor="#71717A" />

                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Padding="16"
                        BackgroundColor="#141816"
                        Stroke="#303833"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 19">

                        <VerticalStackLayout Spacing="9">

                            <Label
                                Text="REMAINING"
                                FontSize="10"
                                CharacterSpacing="1"
                                TextColor="#A1A1AA" />

                            <Label
                                x:Name="OverviewRemainingLabel"
                                Text="0"
                                FontSize="30"
                                FontAttributes="Bold"
                                TextColor="#99F6E4" />

                            <Label
                                Text="In progress"
                                FontSize="12"
                                TextColor="#71717A" />

                        </VerticalStackLayout>
                    </Border>

                </Grid>

                <Border
                    Padding="18"
                    BackgroundColor="#141816"
                    Stroke="#303833"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20">

                    <VerticalStackLayout Spacing="12">

                        <Label
                            Text="YOUR NEXT STEP"
                            FontSize="10"
                            FontAttributes="Bold"
                            CharacterSpacing="1.5"
                            TextColor="#A1A1AA" />

                        <Label
                            x:Name="NextStepTitle"
                            Text="Keep your momentum going."
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="#F4F4F5" />

                        <Label
                            x:Name="NextStepDescription"
                            Text="Choose one manageable task and get started."
                            FontSize="13"
                            TextColor="#A1A1AA" />

                        <Button
                            Text="View my tasks"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Clicked="OnTasksTabClicked"
                            Margin="0,5,0,0" />

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

    <!-- Bottom navigation -->
    <Border
        Grid.Row="1"
        Padding="10,9,10,12"
        BackgroundColor="#111512"
        Stroke="#29312D"
        StrokeThickness="1">

        <Grid ColumnDefinitions="*,*,*"
              ColumnSpacing="8">

            <Border
                x:Name="TasksNavItem"
                Padding="6,8"
                BackgroundColor="#172B28"
                Stroke="#31534C"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 15">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTasksTabClicked" />
                </Border.GestureRecognizers>

                <VerticalStackLayout Spacing="4"
                                     HorizontalOptions="Center">

                    <Label
                        x:Name="TasksNavIcon"
                        Text="□"
                        FontSize="22"
                        TextColor="#99F6E4"
                        HorizontalTextAlignment="Center" />

                    <Label
                        x:Name="TasksNavLabel"
                        Text="Tasks"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="#99F6E4"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>
            </Border>

            <Border
                x:Name="TodayNavItem"
                Grid.Column="1"
                Padding="6,8"
                BackgroundColor="Transparent"
                Stroke="Transparent"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 15">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTodayTabClicked" />
                </Border.GestureRecognizers>

                <VerticalStackLayout Spacing="4"
                                     HorizontalOptions="Center">

                    <Label
                        x:Name="TodayNavIcon"
                        Text="◷"
                        FontSize="22"
                        TextColor="#71717A"
                        HorizontalTextAlignment="Center" />

                    <Label
                        x:Name="TodayNavLabel"
                        Text="Today"
                        FontSize="11"
                        TextColor="#71717A"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>
            </Border>

            <Border
                x:Name="ProgressNavItem"
                Grid.Column="2"
                Padding="6,8"
                BackgroundColor="Transparent"
                Stroke="Transparent"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 15">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnProgressTabClicked" />
                </Border.GestureRecognizers>

                <VerticalStackLayout Spacing="4"
                                     HorizontalOptions="Center">

                    <Label
                        x:Name="ProgressNavIcon"
                        Text="↗"
                        FontSize="22"
                        TextColor="#71717A"
                        HorizontalTextAlignment="Center" />

                    <Label
                        x:Name="ProgressNavLabel"
                        Text="Progress"
                        FontSize="11"
                        TextColor="#71717A"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>
            </Border>

        </Grid>
    </Border>

</Grid>

</ContentPage>